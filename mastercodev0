                  const scaleY = 100 / masterStockW;

                  const wasteZones = [];
                  sheet.freeRects.forEach((fr, fIdx) => {
                    if (fr.w > 15 && fr.h > 15) {
                      wasteZones.push({
                        id: `W-${fIdx}`,
                        x: fr.x,
                        y: fr.y,
                        w: fr.w,
                        h: fr.h
